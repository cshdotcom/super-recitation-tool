generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A recitation / memorization card. Every record gets a UUID.
// `keywords` : JSON string[] of words blanked out (挖空)
// `strokes`  : JSON doodle strokes — legacy [x,y][] arrays or
//              { pts:[x,y][], color, width, tool } objects (涂鸦)
// `plan`     : JSON {"goal":number} daily recitation plan (今日计划)
// `mindmaps` : JSON MindmapDoc[] saved mind maps for this card (思维导图)
// `blocks`   : JSON MaterialBlock[] 文字编辑工具 Q&A blocks
//              [{ front, back, hidden }] (核心论点/完整内容)
// `deletedAt`: soft-delete timestamp — set when moved to 回收站, null = active
model Card {
  id         String    @id @default(uuid())
  title      String
  content    String
  keywords   String    @default("[]")
  strokes    String    @default("[]")
  plan       String    @default("")
  mindmaps   String    @default("[]")
  blocks     String    @default("[]")
  categoryId String    @default("") // 项目分类 id（"" = 未分类）
  pinned     Boolean   @default(false) // 置顶
  ord        Int       @default(0) // 自定义排序序号
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // ---- 间隔复习（SM-2 简化版）----
  // nextReviewAt 为空 = 从未复习过（新导入卡片，进入待复习队列）
  nextReviewAt  DateTime?
  ease          Float    @default(2.5) // SM-2 难度系数，1.3~3.0
  interval      Int      @default(0) // 当前间隔（天）
  reviewCount   Int      @default(0) // 已复习次数
  lastReviewedAt DateTime?
}

// 项目（分类文件夹）— 侧边栏「项目」区。删除项目时卡片移入未分类("")。
model Project {
  id        String   @id @default(uuid())
  name      String
  ord       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton settings row (id = "singleton").
// `theme`     : light | dark | green(护眼) | sepia(羊皮纸) | system
// `voicePrefs`: JSON per-context TTS/ASR voice defaults
//               { [ctx:string]: { tts:{provider,voice,speed,voiceURI}, asr:{provider,lang} } }
model Settings {
  id          String  @id
  clozeStyle  String  @default("circle")    // circle(圈圈) | underline(下划线)
  showAnswers Boolean @default(false)
  tools       String  @default("")          // JSON ToolToggles
  fontSize    Int     @default(18)          // 字体设置 (px)
  pageMode    String  @default("scroll")    // scroll(上下滑动) | paged(左右滑动)
  theme       String  @default("system")    // light | dark | green | sepia | system
  voicePrefs  String  @default("{}")        // JSON per-context voice defaults
  aiProvider  String  @default("zai")       // zai | custom
  aiBaseURL   String?
  aiApiKey    String?
  aiModel     String?
  // TTS provider: zai | custom(OpenAI 兼容 /audio/speech) | browser(Web Speech API)
  ttsProvider String  @default("zai")
  ttsBaseURL  String?
  ttsApiKey   String?
  ttsModel    String?
  // 全局默认 TTS 音色/倍速（per-context voicePrefs 未设置时回退到此）。
  // ttsVoice: z-ai 音色名（tongtong/chuichui/...）或 custom 音色 id；空 = 默认童童。
  // ttsSpeed: 0.5-3 倍速（默认 1）。
  ttsVoice    String?
  ttsSpeed    Float?
  // ASR provider: zai | custom(OpenAI 兼容 /audio/transcriptions) | browser(SpeechRecognition)
  asrProvider String  @default("zai")
  asrBaseURL  String?
  asrApiKey   String?
  asrModel    String?
  // 错题本：答对后自动移除错题 — 答对N次后 (1/2/3/5)
  quizAutoRemove Int @default(2)
  // 导入时是否开启 AI 自动挖空
  aiAutoCloze Boolean @default(false)
  // AI 出题完成后默认自动存入试卷夹（不弹窗询问）；关闭则弹窗让用户选择
  quizAutoPaper Boolean @default(true)
  // ---- AI 对话全局配置（服务端持久化，多端同步）----
  aiSystemPrompt String  @default("")  // 系统提示词
  aiRules        String  @default("")  // 自定义规则（追加到系统提示词）
  aiSelfThinking Boolean @default(false) // 自我思考开关
  aiTemperature  Float?  // 采样温度（空 = 默认）
  aiMaxTokens    Int?    // 最大 tokens（空 = 默认）
  // ---- PDF 解析引擎: auto(推荐,多引擎链) | unpdf | pdf-parse ----
  pdfEngine String @default("auto")
}

// The single app account. Registration is only allowed while this table is
// empty (初始化注册), afterwards login-only.
model Account {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  avatar       String   @default("") // data URL (small, client-resized)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Server-side session tokens referenced by the httpOnly `sb_session` cookie.
model Session {
  token     String   @id
  accountId String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// One share link per card / conversation. expiresAt = null means 无限 (never expires).
// kind: card(书籍内容分享) | conversation(AI对话分享)。refId = 对话 id（kind=conversation）。
model Share {
  id        String    @id @default(uuid())
  token     String    @unique
  cardId    String    @default("")
  kind      String    @default("card")
  refId     String    @default("")
  title     String    @default("")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// 待播放列表 — 全局朗读播放队列（跨书本）。label = 片段名（整本朗读为空）。
// startText/endText = 片段起止锚文本（内容子串匹配，各取 ≤60 字）。
model PlayItem {
  id        String   @id @default(uuid())
  cardId    String
  cardTitle String   @default("")
  label     String   @default("")
  startText String   @default("")
  endText   String   @default("")
  ord       Int      @default(0)
  createdAt DateTime @default(now())
}

// 试卷夹 — 按书本（Card）独立划分。items = JSON 题目数组（与 quiz-panel 题型一致）。
// source: ai(AI出题) | manual(手动组卷) | wrong(错题组卷)。
model Paper {
  id        String   @id @default(uuid())
  cardId    String
  cardTitle String   @default("")
  title     String   @default("")
  items     String   @default("[]")
  source    String   @default("ai")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI 对话 — 独立会话（侧边栏统一管理）。
// type: chat(自由对话) | analysis(题目解析) | favorite(收藏解析) | followup(追问) | supervise(督背)
model Conversation {
  id        String   @id @default(uuid())
  title     String   @default("新对话")
  type      String   @default("chat")
  pinned    Boolean  @default(false)
  cardId    String   @default("") // 来源书本（可选，解析/督背场景）
  // 自定义排序（拖动排序保存；其他排序模式下仅展示用）
  ord       Int      @default(0)
  // 主对话（侧边栏置顶的「AI问问」）：不可删除/改名/直接分享，仅可清空消息
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // user | assistant
  content        String
  images         String   @default("[]") // JSON string[]（dataURL，压缩后）
  createdAt      DateTime @default(now())
}

// A quiz question stored on the server: 错题本 (wrong questions) + 收藏题目.
// Every wrong answer creates/updates a row (wrongCount++). A correct answer
// bumps rightStreak; once it reaches the user's "答对N次后移除" threshold the
// row is auto-removed (removed=true). favorite=true rows show in 收藏题目.
model QuizItem {
  id          String   @id @default(uuid())
  cardId      String
  cardTitle   String   @default("")
  type        String   // fill | short | choice
  question    String
  answer      String
  options     String   @default("[]") // JSON string[] for choice
  wrongCount  Int      @default(0)
  rightCount  Int      @default(0)
  rightStreak Int      @default(0)
  favorite    Boolean  @default(false)
  removed     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 专注内容 (focus timer presets): name + default duration + background image
// (preset key like "bg-silk" or a small client-compressed dataURL).
model FocusContent {
  id        String   @id @default(uuid())
  name      String
  minutes   Int      @default(25)
  bg        String   @default("")
  ord       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per completed focus session — powers 今日 X 分钟 / 已专注 N 次 stats.
model FocusLog {
  id        String   @id @default(uuid())
  // 关联专注内容（自由专注未选内容时为空，用 name 记录展示名）
  contentId String?
  name      String   @default("")
  seconds   Int      @default(0)
  createdAt DateTime @default(now())
}

// 复习计划模板 (review plan schedules). 标准艾宾浩斯 is seeded builtIn=true;
// custom plans are created from 复习计划管理. `days` = JSON number[] — review
// offsets in days (0 = 现在/当天).
model ReviewPlan {
  id        String   @id @default(uuid())
  name      String
  days      String   @default("[]")
  builtIn   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per review/score action (熟悉/模糊/忘记) or quiz answer, so all
// statistics (今日复习/连续复习/今日用时/掌握情况/复习日历/答题报告) are
// aggregated from server data.
// action: familiar | fuzzy | forget | quiz-right | quiz-wrong
model ReviewLog {
  id          String   @id @default(uuid())
  cardId      String
  cardTitle   String   @default("")
  action      String
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())
}

// AI问问 / AI督背 对话历史 — 服务端持久化，刷新/换设备不丢。
// mode: ask(AI问问) | supervise(AI督背)；role: user | assistant。
// images: JSON string[]（用户消息附图 dataURL，压缩后入库）。
model ChatLog {
  id        String   @id @default(uuid())
  cardId    String   @default("")
  mode      String   // ask | supervise
  role      String   // user | assistant
  content   String
  images    String   @default("[]")
  createdAt DateTime @default(now())
}

// 挖空背诵成绩记录 — 每次语音背诵/挖空自评打分后落库，服务端可查历史。
// score: 准确率 0-100；missed/matched: JSON string[] 关键词。
model ReciteLog {
  id        String   @id @default(uuid())
  cardId    String
  cardTitle String   @default("")
  score     Int      @default(0)
  text      String   @default("")
  missed    String   @default("[]")
  matched   String   @default("[]")
  createdAt DateTime @default(now())
}

// 通用 KV 状态（服务端持久化）— 答题草稿、作答记录、每日背诵计划进度、
// 眼睛按钮位置、涂鸦调色板、TTS 音色记忆等一切原本散落在 localStorage
// 的用户数据统一搬到这里，保证「所有数据都存在服务端」。
// key 形如 "quiz:draft:<cardId>" / "plan:<cardId>:<YYYY-MM-DD>" / "ui:eyeFabPos"。
model AppState {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

// 图片服务器 — 编辑器里以「链接方式」插入的图片可转存到服务端（POST /api/upload），
// 之后正文引用 /api/upload/<id>，不再依赖外部图床（图片不丢、离线可用）。
// data = base64（不含 data: 前缀）；mime 如 image/jpeg。GET /api/upload/:id 公开可读
// （访客分享视图也要渲染图片，所以不做登录校验）。
model Upload {
  id        String   @id @default(uuid())
  mime      String   @default("image/jpeg")
  data      String
  bytes     Int      @default(0)
  createdAt DateTime @default(now())
}
